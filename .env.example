# ─── ROS Bridge ───────────────────────────────────────────────────────────────
# Seleccionar según la versión de ROS del entorno.
# La imagen debe estar construida localmente desde el repo del workspace ROS
# (ver infra/README.md → ROS Bridge).

# ROS 1 (Noetic) — default
ROSBRIDGE_IMAGE=muavgcs:ros1
ROSBRIDGE_CMD=source /root/catkin_ws/devel/setup.bash && roslaunch aerialcore_gui connect_uas.launch

# ROS 2 (Humble / Jazzy) — descomentar y comentar las de arriba
# ROSBRIDGE_IMAGE=muavgcs:ros2
# ROSBRIDGE_CMD=source /opt/ros/${ROS_DISTRO}/setup.bash && ros2 launch rosbridge_server rosbridge_websocket_launch.xml
