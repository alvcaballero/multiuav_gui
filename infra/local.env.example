# DÓNDE está en ESTA máquina cada pieza externa (qué es cada una y qué versión: infra/external.md).
#   cp infra/local.env.example infra/local.env   # gitignored: cada uno el suyo
# Rutas absolutas, sin comillas ni ~ (compose no expande ~). Una variable sin definir = esa pieza no se usa.
# Lo leen: los perfiles de tmuxinator, `docker compose --env-file infra/local.env ...` y Claude.

# Autopilotos
PX4_DIR=/home/<usuario>/PX4-Autopilot
ARDUPILOT_DIR=/home/<usuario>/ardupilot

# Workspaces ROS
ROS2_WS=/home/<usuario>/ros2_px4_ws                 # Jazzy: PX4 + MQTT
ROS2_PSDK_WS=/home/<usuario>/ros2_psdk_ws           # Humble: DJI PSDK (psdk_ros2 no compila en Jazzy)
ROS1_DOCKER_DIR=/home/<usuario>/ros_docker_volume

# Piezas sueltas
GLYPHSERVER_DIR=/home/<usuario>/glyphserver
MAP_TILES_DIR=/home/<usuario>/map_data
SJTU_DIR=/home/<usuario>/sjtu_drone

# Imagen del ROS bridge ROS 1, si la tuya no se llama muavgcs:ros1
# ROS1_IMAGE=muavgcs:ros1
