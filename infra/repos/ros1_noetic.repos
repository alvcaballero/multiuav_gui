# Workspace catkin (ROS 1 Noetic): ROS bridge, DJI OSDK, PX4 por mavros y robofleet (ver infra/external.md).
#   vcs import <catkin_ws>/src < infra/repos/ros1_noetic.repos
# DJI Onboard-SDK (no es catkin) se instala aparte: infra/guides/ros1-workspace.md.
repositories:
  # aerialcore_common (mensajes del GCS), aerialcore_gui, onboard_dji, onboard_px4
  multiUAV_system:
    type: git
    url: https://github.com/alvcaballero/multiUAV_system.git
    version: main
  Onboard-SDK-ROS:
    type: git
    url: https://github.com/miggilcas/Onboard-SDK-ROS.git
    version: dev
  robofleet_client:
    type: git
    url: https://github.com/arpoma16/robofleet_client.git
    version: master
  # mission_lib, del que depende onboard_px4
  grvc-utils:
    type: git
    url: https://github.com/grvcTeam/grvc-utils.git
    version: noetic
