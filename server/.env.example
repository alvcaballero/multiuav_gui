PORT= 4000
CORS_ENABLE = false

MAP_LATITUDE = 37.410418
MAP_LONGITUDE = -6.002381

ROS_CONNECTION = true
#ROS_URL=ws://127.0.0.1:9090
# Subscribe a ROS device only once its topics exist in the ROS graph (needs rosapi, ROS2 only for now).
# false = subscribe every registered device at connect, as before.
#ROS_LAZY_SUBSCRIBE=false
#ROS_DISCOVERY_INTERVAL_MS=10000
FB_CONNECTION = false
#FB_CONNECTION=true
#MAVLINK_CONNECTION=true
#MQTT_CONNECTION=true


STREAM_SERVER = false
LOCAL_GLYPHS = false

DB =  false # false -> sqlite
DB_TYPE = "postgres"
DB_NAME = "my_db"
DB_USER = "admin"
DB_PASSWORD = "admin123"
DB_HOST = "127.0.0.1"
DB_PORT = "5432"

NO_ELEVATION = false


PLANNING_SERVER =  false 
PLANNING_HOST= "http://127.0.0.1:8004"

MISSION_DATA_PATH = '/home/grvc/work/GCS_media/'
PROCESS_THERMAL_IMG = false
PROCESS_THERMAL_IMG_SRC = 'source activate DJIThermal && python3 /home/grvc/work/px4/multiuav_gui/scripts/utils/processThemalimages.py '



EXT_APP =  false 
EXT_APP_URL= "http://127.0.0.1:1234"
EXT_APP_USER= "user"
EXT_APP_PWD= "password"

LLM = false
LLM_PROVIDER = "openai" # openai, gemini, anthropic, ollama,llamacpp
LLM_OPENAI_API_KEY = "your_openai_api_key"
LLM_GEMINI_API_KEY = "your_gemini_api_key"
LLM_ANTHROPIC_API_KEY = "your_anthropic_api_key"
LLM_OLLAMA_BASE_URL = "http://127.0.0.1:11434"
LLM_LLAMACPP_BASE_URL = "http://localhost:8080/v1"
MCP_ENABLE = true
MCP_CONFIG = '{"transport": "http","url": "http://127.0.0.1:3001/mcp/"}'

# --- eve agent (opt-in per chat, runs alongside the legacy chat) ---
EVE_ENABLE=false

# Agents eve serves. eve cannot list them, so they are declared here: name -> base URL, up to
# (not including) /v1. JSON on ONE line.
#   dev:all       -> one path per agent:  {"assistant":"http://localhost:3300/eve/assistant"}
#   dev:assistant -> a single agent:      {"assistant":"http://localhost:2000/eve"}
EVE_AGENTS={"assistant":"http://localhost:3300/eve/assistant"}

# Agent a new eve chat talks to when the request does not name one (default: the first in EVE_AGENTS).
# EVE_DEFAULT_AGENT=assistant

# Legacy shape, used only when EVE_AGENTS is not set: one agent called "assistant" (dev:assistant).
# The /eve mount is added if missing.
# EVE_URL=http://127.0.0.1:2000

# --- radio link quality (models/radio/) ---
# SNR of each drone's radio, read over SNMP from the GCS's Ubiquiti access point (AirOS station table).
# A device is matched to its row by its `radioIp` / `radioMac` attribute. Empty (default) = off: no polling, no chip.
#RADIO_AP_HOST=10.20.0.100
#RADIO_AP_COMMUNITY=public
# AirOS 8 of 2018 answers SNMP v1 only (v2c times out); change it only for a newer firmware.
#RADIO_SNMP_VERSION=1
#RADIO_POLL_INTERVAL_MS=3000
#RADIO_SNMP_TIMEOUT_MS=2000

# Ping to the onboard computer of each device that sets its `companionIp` attribute (RTT, jitter, loss).
# On by default but it only touches devices with that address. Needs Linux `ping` on the host running the server.
#PING_ENABLE=false
#PING_INTERVAL_MS=2000
#PING_WINDOW=20
