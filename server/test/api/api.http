Content-Type: application/json

{
    "name": "uav_14",
    "category": "dji_M300",
    "protocol": "ros",
    "ip": "10.20.0.52",
    "camera":[
        {
            "type": "WebRTC",
            "source": "main"
        }
    ],
    "files":[
        {
            "type": "onboard_computer",
            "url": "sftp://one:1234@127.0.0.1:4021"
        }
    ]
}

